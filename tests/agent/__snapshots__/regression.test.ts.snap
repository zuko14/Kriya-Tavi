      ],
      "type": "object",
    },
  },
  "gmail_search": {
    "description": "Search the person's Gmail with Gmail's search syntax (from:, subject:, newer_than:7d, is:unread). Returns senders, subjects, dates and snippets.",
    "input": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
