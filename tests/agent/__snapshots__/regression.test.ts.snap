      ],
      "type": "object",
    },
  },
  "memory_forget": {
    "description": "Delete a note from your memory by its id, when it is wrong, outdated or the person asks you to forget it.",
    "input": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "properties": {
        "id": {
          "description": "The note's id, shown in your memory",
          "maxLength": 32,
          "type": "string",
        },
      },
      "required": [
        "id",
      ],
      "type": "object",
    },
  },
  "memory_write": {
    "description": "Save a durable note to your long-term memory. It will be in front of you in every future conversation, in every thread. Use it for facts about the person, their projects, preferences, decisions and standing instructions — and whenever they ask you to remember something.",
    "input": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "properties": {
        "note": {
          "description": "One self-contained statement that makes sense without this conversation",
          "maxLength": 2000,
          "minLength": 1,
          "type": "string",
        },
      },
      "required": [
        "note",
      ],
      "type": "object",
    },
  },
  "notion_read": {
    "description": "Read a Notion page's text by its id from notion_search.",
