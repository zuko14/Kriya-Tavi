# ─────────────────────────────────────────────────────────────────────────────
#  Kriya Tavi — environment
#  Copy to .env.local for development. Never commit real values.
#  Full table (which service needs what): docs/kriya/deployment.md
# ─────────────────────────────────────────────────────────────────────────────

# ── Required ──
KRIYA_APP_URL=http://127.0.0.1:6796
# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Supabase → Connect → Transaction pooler (port 6543)
DATABASE_URL=
# Session pooler or direct connection (port 5432), for `npm run db:migrate` only
MIGRATION_DATABASE_URL=
# Server only: account deletion and owner lookups
SUPABASE_SECRET_KEY=

# ── Models (OpenRouter) ──
OPENROUTER_API_KEY=
OPENROUTER_DEFAULT_MODEL=deepseek/deepseek-v4-flash

# ── Optional features ──
FIRECRAWL_API_KEY=
# KRIYA_FX_USD_INR=
# KRIYA_FX_SOURCE=
KRIYA_TOKEN_KEY=
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# NOTION_CLIENT_ID=
# NOTION_CLIENT_SECRET=

# ── Billing ──
# KRIYA_BILLING_PROVIDER=test
# RAZORPAY_KEY_ID=
# RAZORPAY_KEY_SECRET=
# RAZORPAY_WEBHOOK_SECRET=
# KRIYA_SUPPORT_EMAIL=
