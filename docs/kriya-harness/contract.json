{
  "basePath": "/api/harness/v1",
  "headers": {
    "version": "X-Kriya-Harness",
    "auth": "Authorization: Bearer <device token>"
  },
  "error": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "error": {
        "type": "string",
        "enum": [
          "not_found",
          "bad_request",
          "upgrade",
          "unauthorized",
          "suspended",
          "rate_limited",
          "pending",
          "denied",
          "expired",
          "server_error",
          "harness_off",
          "plan_not_allowed",
          "tier_not_allowed",
          "cap_reached",
          "not_priced",
          "upstream_unavailable",
          "context_length_exceeded",
          "no_agent",
          "mirror_summary_only",
          "not_connected",
          "too_large",
          "patch_mismatch",
          "no_checkpoint",
          "task_refused"
        ]
      },
      "message": {
        "type": "string"
      },
      "minVersion": {
        "type": "string"
      },
      "retryAfter": {
        "type": "integer",
        "minimum": -9007199254740991,
        "maximum": 9007199254740991
      }
    },
    "required": ["error", "message"],
    "additionalProperties": false
  },
  "routes": [
    {
      "method": "POST",
      "path": "/device/code",
      "auth": false,
      "request": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "deviceName": {
            "type": "string",
            "minLength": 1,
            "maxLength": 60
          },
          "platform": {
            "type": "string",
            "enum": ["darwin", "linux", "win32"]
          },
          "clientVersion": {
            "type": "string",
            "pattern": "^\\d{1,3}\\.\\d{1,3}\\.\\d{1,3}$"
          }
        },
        "required": ["deviceName", "platform", "clientVersion"],
        "additionalProperties": false
      },
      "response": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "deviceCode": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{43}$"
          },
          "userCode": {
            "type": "string",
            "pattern": "^[A-HJ-NP-Z2-9]{4}-[A-HJ-NP-Z2-9]{4}$"
          },
          "verificationUrl": {
            "type": "string",
            "format": "uri"
          },
          "expiresIn": {
            "type": "number",
            "const": 600
          },
          "interval": {
            "type": "number",
            "const": 5
          }
        },
        "required": [
          "deviceCode",
          "userCode",
          "verificationUrl",
          "expiresIn",
          "interval"
        ],
        "additionalProperties": false
      }
    },
    {
      "method": "POST",
      "path": "/device/token",
      "auth": false,
      "request": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "deviceCode": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{43}$"
          }
        },
        "required": ["deviceCode"],
        "additionalProperties": false
      },
      "response": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "token": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{43}$"
          },
          "deviceId": {
            "type": "string",
            "format": "uuid",
            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
          }
        },
        "required": ["token", "deviceId"],
        "additionalProperties": false
      }
    },
    {
      "method": "GET",
      "path": "/me",
      "auth": true,
      "request": null,
      "response": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "displayName": {
            "type": ["string", "null"]
          },
          "plan": {
            "type": "string"
          },
          "harness": {
            "type": "object",
            "properties": {
              "enabled": {
                "type": "boolean"
              },
              "capMicroInr": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "usedMicroInr": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "unpriced": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              }
            },
            "required": ["enabled", "capMicroInr", "usedMicroInr", "unpriced"],
            "additionalProperties": false
          },
          "agent": {
            "anyOf": [
              {
                "type": "object",
                "properties": {
                  "id": {
                    "type": "string"
                  },
                  "name": {
                    "type": "string"
                  }
                },
                "required": ["id", "name"],
                "additionalProperties": false
              },
              {
                "type": "null"
              }
            ]
          },
          "minClientVersion": {
            "type": "string",
            "pattern": "^\\d{1,3}\\.\\d{1,3}\\.\\d{1,3}$"
          }
        },
        "required": ["displayName", "plan", "harness", "agent", "minClientVersion"],
        "additionalProperties": false
      }
    },
    {
      "method": "DELETE",
      "path": "/device",
      "auth": true,
      "request": null,
      "response": null
    },
    {
      "method": "GET",
      "path": "/models",
      "auth": true,
      "request": null,
      "response": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "object": {
            "type": "string",
            "const": "list"
          },
          "data": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "enum": ["budget", "balanced", "escalation"]
                },
                "object": {
                  "type": "string",
                  "const": "model"
                },
                "owned_by": {
                  "type": "string",
                  "const": "kriya"
                },
                "name": {
                  "type": "string",
                  "pattern": "^[\\p{L}\\p{N} .()+\\/:_-]{1,60}$"
                },
                "contextWindow": {
                  "type": "integer",
                  "exclusiveMinimum": 0,
                  "maximum": 9007199254740991
                },
                "maxOutputTokens": {
                  "type": "integer",
                  "exclusiveMinimum": 0,
                  "maximum": 9007199254740991
                }
              },
              "required": ["id", "object", "owned_by"],
              "additionalProperties": false
            }
          },
          "bodyEncodings": {
            "type": "array",
            "items": {
              "type": "string",
              "const": "gzip+base64"
            }
          }
        },
        "required": ["object", "data"],
        "additionalProperties": false
      }
    },
    {
      "method": "POST",
      "path": "/chat/completions",
      "auth": true,
      "request": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "model": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "messages": {
            "minItems": 1,
            "maxItems": 2000,
            "type": "array",
            "items": {}
          },
          "stream": {
            "type": "boolean"
          },
          "max_tokens": {
            "type": "integer",
            "exclusiveMinimum": 0,
            "maximum": 9007199254740991
          },
          "max_completion_tokens": {
            "type": "integer",
            "exclusiveMinimum": 0,
            "maximum": 9007199254740991
          }
        },
        "required": ["model", "messages"],
        "additionalProperties": {}
      },
      "response": null
    },
    {
      "method": "POST",
      "path": "/approvals",
      "auth": true,
      "request": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "sessionRef": {
            "type": "string",
            "maxLength": 100
          },
          "tool": {
            "type": "string",
            "minLength": 1,
            "maxLength": 60
          },
          "summary": {
            "type": "string",
            "minLength": 1,
            "maxLength": 300
          },
          "input": {
            "type": "object",
            "propertyNames": {
              "type": "string"
            },
            "additionalProperties": {}
          },
          "cwd": {
            "type": "string",
            "maxLength": 300
          }
        },
        "required": ["sessionRef", "tool", "summary", "input"],
        "additionalProperties": false
      },
      "response": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
          },
          "expiresAt": {
            "type": "string",
            "format": "date-time",
            "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
          }
        },
        "required": ["id", "expiresAt"],
        "additionalProperties": false
      }
    },
    {
      "method": "GET",
      "path": "/approvals/{id}",
      "auth": true,
      "request": null,
      "response": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": ["pending", "approved", "declined", "expired", "canceled"]
          }
        },
        "required": ["status"],
        "additionalProperties": false
      }
    },
    {
      "method": "DELETE",
      "path": "/approvals/{id}",
      "auth": true,
      "request": null,
      "response": null
    },
    {
      "method": "POST",
      "path": "/sessions",
      "auth": true,
      "request": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "deviceSessionId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "project": {
            "type": "string",
            "maxLength": 80
          },
          "title": {
            "type": "string",
            "maxLength": 80
          }
        },
        "required": ["deviceSessionId", "project", "title"],
        "additionalProperties": false
      },
      "response": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "sessionId": {
            "type": "string",
            "format": "uuid",
            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
          },
          "threadId": {
            "type": "string"
          },
          "mirror": {
            "type": "string",
            "enum": ["summary", "full"]
          }
        },
        "required": ["sessionId", "threadId", "mirror"],
        "additionalProperties": false
      }
    },
    {
      "method": "POST",
      "path": "/sessions/{id}/turns",
      "auth": true,
      "request": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "seq": {
            "type": "integer",
            "minimum": 0,
            "maximum": 2147483647
          },
          "text": {
            "type": "string",
            "maxLength": 65536
          },
          "tools": {
            "maxItems": 100,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "name": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 60
                },
                "status": {
                  "type": "string",
                  "enum": ["ok", "error", "declined"]
                },
                "ms": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                }
              },
              "required": ["name", "status", "ms"],
              "additionalProperties": false
            }
          },
          "full": {
            "type": "object",
            "propertyNames": {
              "type": "string"
            },
            "additionalProperties": {}
          }
        },
        "required": ["seq", "text", "tools"],
        "additionalProperties": false
      },
      "response": null
    },
    {
      "method": "GET",
      "path": "/skills",
      "auth": true,
      "request": null,
      "response": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "skills": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9-]{2,40}$"
                },
                "name": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 60
                },
                "version": {
                  "type": "string",
                  "pattern": "^\\d{1,3}\\.\\d{1,3}\\.\\d{1,3}$"
                },
                "description": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 240
                },
                "activation": {
                  "type": "object",
                  "properties": {
                    "always": {
                      "type": "boolean"
                    },
                    "keywords": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    }
                  },
                  "required": ["always", "keywords"],
                  "additionalProperties": false
                }
              },
              "required": ["id", "name", "version", "description", "activation"],
              "additionalProperties": false
            }
          }
        },
        "required": ["skills"],
        "additionalProperties": false
      }
    },
    {
      "method": "GET",
      "path": "/skills/{id}/{version}",
      "auth": true,
      "request": null,
      "response": null
    },
    {
      "method": "POST",
      "path": "/memory/search",
      "auth": true,
      "request": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "query": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 20
          }
        },
        "required": ["query"],
        "additionalProperties": false
      },
      "response": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "notes": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string"
                },
                "content": {
                  "type": "string"
                },
                "kind": {
                  "type": "string"
                },
                "confirmed": {
                  "type": "boolean"
                },
                "shared": {
                  "type": "boolean"
                }
              },
              "required": ["id", "content", "kind", "confirmed", "shared"],
              "additionalProperties": false
            }
          }
        },
        "required": ["notes"],
        "additionalProperties": false
      }
    },
    {
      "method": "POST",
      "path": "/memory",
      "auth": true,
      "request": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "content": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000
          }
        },
        "required": ["content"],
        "additionalProperties": false
      },
      "response": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "confirmed": {
            "type": "boolean"
          }
        },
        "required": ["id", "confirmed"],
        "additionalProperties": false
      }
    },
    {
      "method": "POST",
      "path": "/handoff",
      "auth": true,
      "request": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "repo": {
            "type": "string",
            "pattern": "^[A-Za-z0-9-]{1,39}\\/[A-Za-z0-9._-]{1,100}$"
          },
          "baseRef": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "baseSha": {
            "type": "string",
            "pattern": "^[0-9a-f]{40}$"
          },
          "note": {
            "type": "string",
            "maxLength": 2000
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "bytes": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          }
        },
        "required": ["repo", "baseRef", "baseSha", "sha256", "bytes"],
        "additionalProperties": false
      },
      "response": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "threadId": {
            "type": "string"
          },
          "workspaceId": {
            "type": "string",
            "format": "uuid",
            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
          },
          "taskId": {
            "type": "string",
            "format": "uuid",
            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
          },
          "url": {
            "type": "string",
            "format": "uri"
          }
        },
        "required": ["threadId", "workspaceId", "taskId", "url"],
        "additionalProperties": false
      }
    },
    {
      "method": "GET",
      "path": "/workspaces/{id}/checkpoint",
      "auth": true,
      "request": null,
      "response": null
    },
    {
      "method": "GET",
      "path": "/world",
      "auth": true,
      "request": null,
      "response": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "deviceId": {
            "type": "string",
            "format": "uuid",
            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
          },
          "relayUrl": {
            "type": "string",
            "format": "uri"
          }
        },
        "required": ["deviceId", "relayUrl"],
        "additionalProperties": false
      }
    },
    {
      "method": "POST",
      "path": "/daemon/hello",
      "auth": true,
      "request": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "daemonVersion": {
            "type": "string",
            "pattern": "^\\d{1,3}\\.\\d{1,3}\\.\\d{1,3}$"
          },
          "capabilities": {
            "type": "object",
            "properties": {
              "fullAccess": {
                "type": "boolean"
              },
              "serve": {
                "type": "boolean"
              },
              "handoff": {
                "type": "boolean"
              }
            },
            "required": ["fullAccess", "serve", "handoff"],
            "additionalProperties": false
          },
          "projects": {
            "maxItems": 50,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{16}$"
                },
                "name": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 80
                },
                "path": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 300
                },
                "git": {
                  "type": "boolean"
                }
              },
              "required": ["id", "name", "path", "git"],
              "additionalProperties": false
            }
          },
          "rules": {
            "maxItems": 200,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "project": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{16}$"
                },
                "n": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 999
                },
                "text": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 400
                },
                "status": {
                  "type": "string",
                  "enum": ["proposed", "confirmed"]
                }
              },
              "required": ["project", "n", "text", "status"],
              "additionalProperties": false
            }
          }
        },
        "required": ["daemonVersion", "capabilities", "projects", "rules"],
        "additionalProperties": false
      },
      "response": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "pollSeconds": {
            "type": "integer",
            "minimum": 1,
            "maximum": 25
          }
        },
        "required": ["pollSeconds"],
        "additionalProperties": false
      }
    },
    {
      "method": "GET",
      "path": "/dispatch/next",
      "auth": true,
      "request": null,
      "response": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "dispatch": {
            "anyOf": [
              {
                "type": "object",
                "properties": {
                  "id": {
                    "type": "string",
                    "format": "uuid",
                    "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
                  },
                  "kind": {
                    "type": "string",
                    "enum": [
                      "run",
                      "doctor",
