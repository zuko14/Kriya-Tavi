{
  "name": "kriya-bots",
  "version": "0.1.0",
  "description": "Kriya Tavi by Kriya AI: an India-first AI agent platform. Verified action: AI that acts, and proves it acted right.",
  "license": "MIT",
  "private": true,
  "type": "module",
  "author": {
    "name": "Kriya AI"
  },
  "contributors": [
    {
      "name": "Sourav Bera",
      "url": "https://souravbera.vercel.app",
      "comment": "Author of MIT-licensed code that Kriya Tavi includes; see LICENSE"
    }
  ],
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1 --port 6796",
    "dev:worker": "tsx watch --env-file-if-exists=.env worker/index.ts",
    "dev:browser": "tsx watch --env-file-if-exists=.env browser/index.ts",
    "build": "next build",
    "start": "next start --hostname 0.0.0.0",
    "worker": "tsx worker/index.ts",
    "browser": "tsx browser/index.ts",
    "test": "vitest run",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:migrate": "tsx scripts/migrate.ts",
    "readiness": "tsx --env-file-if-exists=.env scripts/readiness.ts",
    "owner:grant": "tsx scripts/grant-owner.ts",
    "models:sync": "tsx scripts/sync-models.ts",
    "models:eval": "tsx scripts/eval-models.ts",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm test"
  },
  "dependencies": {
    "@ai-sdk/openai-compatible": "^3.0.67",
    "@ai-sdk/react": "^4.0.140",
    "@base-ui/react": "^1.9.0",
    "@fontsource-variable/fraunces": "^5.3.0",
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@hookform/resolvers": "^5.9.1",
    "@streamdown/code": "^2.0.0",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.118.0",
    "ai": "^7.0.137",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.4.0",
    "drizzle-orm": "^0.45.4",
    "drizzle-zod": "^0.8.3",
    "lucide-react": "^1.55.0",
    "nanoid": "^6.0.2",
    "next": "16.4.0",
    "next-themes": "^0.4.6",
    "playwright-core": "1.64.1",
    "postgres": "^3.4.9",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-hook-form": "^7.89.0",
    "react-resizable-panels": "^4.14.4",
    "server-only": "^0.0.1",
    "streamdown": "^2.7.0",
    "tailwind-merge": "^3.7.0",
    "tsx": "^4.23.15",
    "tw-animate-css": "^1.4.0",
    "use-stick-to-bottom": "^1.1.6",
    "ws": "8.22.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.10",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/ws": "8.18.2",
    "eslint": "^10",
    "eslint-config-next": "16.4.0",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^5",
    "vitest": "^5.0.5"
  }
}
